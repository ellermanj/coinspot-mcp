# Required for remote/Lambda MCP access (Authorization: Bearer ...)
COINSPOT_MCP_AUTH_TOKEN=long-random-mcp-bearer-token

# CoinSpot user credentials are NOT configured here for remote multi-user mode.
# The LLM must pass coinspot_api_key + coinspot_api_secret on each authenticated tool call.
# Optional local/dev fallback only if you explicitly enable use_env_fallback in code:
# COINSPOT_API_KEY=your_api_key
# COINSPOT_API_SECRET=your_api_secret

# Optional safety switches (default: disabled)
# Trading/withdrawal tools are only registered when these are true
COINSPOT_ALLOW_TRADING=false
COINSPOT_ALLOW_WITHDRAWALS=false

# Optional runtime guards for destructive actions
COINSPOT_DESTRUCTIVE_CONFIRM_TOKEN=
COINSPOT_MAX_ORDER_AMOUNT=
COINSPOT_MAX_WITHDRAW_AMOUNT=
COINSPOT_WITHDRAW_ADDRESS_ALLOWLIST=
