# CoinSpot API credentials from https://www.coinspot.com.au/my/api
COINSPOT_API_KEY=your_api_key
COINSPOT_API_SECRET=your_api_secret

# Optional safety switches (default: disabled)
# Set to "true" to allow place/edit/cancel order tools
COINSPOT_ALLOW_TRADING=false
# Set to "true" to allow coin withdrawal tools (requires key permission enabled on CoinSpot)
COINSPOT_ALLOW_WITHDRAWALS=false
