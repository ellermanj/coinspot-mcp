# Required for remote/Lambda MCP access (Authorization: Bearer ...)
# Generate with: openssl rand -hex 32
# Do NOT deploy example/placeholder values.
COINSPOT_MCP_AUTH_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# Optional: comma-separated additional MCP bearer tokens for per-user gateway auth
COINSPOT_MCP_AUTH_TOKENS=

# After deploy, set Function URL hostname (no https://) to enable DNS rebinding protection
COINSPOT_MCP_ALLOWED_HOSTS=

# CoinSpot user credentials are NOT configured here for remote multi-user mode.
# The LLM must pass coinspot_api_key + coinspot_api_secret on each authenticated tool call.

# Optional – destructive tools disabled by default
COINSPOT_ALLOW_TRADING=false
COINSPOT_ALLOW_WITHDRAWALS=false

# REQUIRED when enabling trading or withdrawals (openssl rand -hex 32)
COINSPOT_DESTRUCTIVE_CONFIRM_TOKEN=

# Optional runtime guards for destructive actions
COINSPOT_MAX_ORDER_AMOUNT=
COINSPOT_MAX_WITHDRAW_AMOUNT=
COINSPOT_WITHDRAW_ADDRESS_ALLOWLIST=
